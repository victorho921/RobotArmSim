<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aubo_i5">

    <gazebo>
      <plugin
        filename="ign_ros2_control-system"
        name="ign_ros2_control::IgnitionROS2ControlPlugin">

        <parameters>
          $(find gazebo_practise)/controller_config/aubo_controller.yaml
        </parameters>

      </plugin>
    </gazebo>
</robot>