<?xml version="1.0" encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- 1. Include your original URDF -->
  <xacro:include filename="$(find aubo_description_modify)/urdf/aubo_i5_calibrated.urdf" />

  <!-- 2. Fix the base to the Gazebo world (prevents arm from falling/floating) -->
  <!-- <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/> 
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint> -->

  <!-- 3. Include Gazebo extensions -->
  <xacro:include filename="$(find aubo_description_modify)/urdf/aubo_i5_gazebo.xacro" />

  <!-- 4. Include Control Interface -->
  <xacro:include filename="$(find aubo_description_modify)/urdf/aubo_i5_control.xacro" />

</robot>